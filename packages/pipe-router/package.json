{
    "name": "@hmallen99/pipe-router",
    "version": "1.1.0",
    "description": "Pipe Router Library",
    "main": "dist/src/index.js",
    "types": "dist/src/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hmallen99/pipe.git"
    },
    "scripts": {
        "test": "jest",
        "build": "npx swc ./src -d ./dist --ignore **/*.spec.ts",
        "typecheck": "npx tsc --noEmit ./src/*.ts",
        "generate-types": "npx tsc --emitDeclarationOnly --outDir dist -p tsconfig.json",
        "prepare": "rm -rf ./dist && npm run build && npm run generate-types"
    },
    "author": "Henry Allen",
    "license": "MIT",
    "peer-dependencies": {
        "@hmallen99/pipe": "^1.1.0"
    },
    "devDependencies": {
        "@hmallen99/pipe": "^1.1.0",
        "@typescript-eslint/eslint-plugin": "^7.8.0",
        "@typescript-eslint/parser": "^7.8.0",
        "@swc/cli": "^0.3.12",
        "@swc/core": "^1.4.17",
        "@swc/jest": "^0.2.36",
        "@types/jest": "^29.5.12",
        "jest": "^29.7.0"
    }
}
